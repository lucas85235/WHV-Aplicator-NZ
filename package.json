{
  "name": "whv-aplicator-nz",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de inscricao automatizada no Working Holiday Visa da Nova Zelandia (esquema Brasil, 300 vagas).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "login": "tsc && node dist/src/index.js login",
    "rehearsal": "tsc && node dist/src/index.js rehearsal",
    "scan": "tsc && node dist/src/index.js scan",
    "watch": "tsc && node dist/src/index.js watch",
    "live": "tsc && node dist/src/index.js live",
    "when": "tsc && node dist/src/index.js when",
    "docs": "tsc && node dist/src/index.js docs",
    "chrome": "node dist/src/index.js chrome",
    "open": "powershell -ExecutionPolicy Bypass -File scripts/open-chrome.ps1",
    "watchdog": "powershell -ExecutionPolicy Bypass -File scripts/watchdog.ps1",
    "codegen": "playwright codegen",
    "notify-test": "tsc && node scripts/test-notify.mjs",
    "selftest": "tsc && node scripts/selftest.mjs",
    "secrets": "node scripts/set-login.mjs",
    "probe": "tsc && node dist/src/index.js probe",
    "assist": "tsc && node dist/src/index.js assist",
    "assist-test": "tsc && node scripts/assist-test.mjs"
  },
  "dependencies": {
    "node-notifier": "^10.0.1",
    "otplib": "^12.0.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-notifier": "^8.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
